{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "barryvdh/laravel-dompdf": "^2",
        "binarytorch/larecipe": "^2.6",
        "cknow/laravel-money": "^7.2",
        "coderello/laravel-shared-data": "^4.0.0",
        "cviebrock/eloquent-sluggable": "^9.0.0",
        "darkaonline/l5-swagger": "^8.0",
        "doctrine/dbal": "^3.6",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/fortify": "^1.7",
        "laravel/framework": "^9.52",
        "laravel/helpers": "^1.6",
        "laravel/passport": "^10.4.1",
        "laravel/tinker": "^2.7",
        "maatwebsite/excel": "^3.1",
        "mpociot/vat-calculator": "^3.4",
        "mtownsend/collection-xml": "^1.7",
        "mtownsend/response-xml": "^2.2",
        "predis/predis": "^2.3",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-medialibrary": "^10.7",
        "spatie/laravel-query-builder": "^5.0.0",
        "yajra/laravel-datatables": "^1.5",
        "yajra/laravel-datatables-oracle": "^9.21.2"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.7",
        "barryvdh/laravel-ide-helper": "^2.13",
        "spatie/laravel-ignition": "^1.4",
        "fakerphp/faker": "^1.9.1",
        "laravel/sail": "^1.15",
        "mockery/mockery": "^1.4.2",
        "nunomaduro/collision": "^6.3",
        "phpunit/phpunit": "^9.3.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "files": [
            "app/Helpers/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
